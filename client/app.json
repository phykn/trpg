{
  "expo": {
    "name": "말과 주사위",
    "slug": "trpg_client",
    "version": "0.0.5",
    "icon": "./assets/images/icon.png",
    "scheme": "trpgclient",
    "userInterfaceStyle": "light",
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#efede6"
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
