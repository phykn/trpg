  "descriptions": {
    "chapter": {
      "name": "마지막 배",
      "text": ""
    },
    "square": {
      "name": "부두 광장",
      "text": "안개 속에서 배의 불빛이 흔들립니다. 압송 명단 앞에 선 조사관이 지워진 이름을 살피고 있습니다."
    },
    "tavern": {
      "name": "닻 없는 선술집",
      "text": "잔은 모두 뒤집혀 있지만 작은 난로는 아직 따뜻합니다. 주인은 문이 열릴 때마다 찻잔 하나를 바로 놓습니다."
    },
    "prison": {
      "name": "세관 감옥",
      "text": "쇠창살 너머에서 익숙한 휘파람이 들립니다. 문 앞의 경비는 당신보다 피곤해 보입니다."
    },
    "warehouse": {
      "name": "화물 창고",
      "text": "젖은 밧줄 냄새 사이로 종이 넘기는 소리가 납니다. 서기와 밀수상이 서로를 못 본 척하고 있습니다."
    },
    "tower": {
      "name": "신호탑",
      "text": "항구의 지붕들이 발아래 잠겨 있습니다. 오래된 신호등은 누군가의 손길을 기다립니다."
    },
    "player": {
      "name": "당신",
      "text": ""
    },
    "guard": {
      "name": "경비 도윤",
      "text": "창자루를 자꾸 고쳐 잡습니다. 겁을 주려는 사람치고는 시선을 너무 자주 피합니다."
    },
    "keeper": {
      "name": "주인 모라",
      "text": "빈 찻잔에도 따뜻한 물을 붓습니다. 이 항구에서는 빚도 식으면 안 된다고 말합니다."
    },
    "sailor": {
      "name": "뱃사람 나루",
      "text": "휘파람의 마지막 음을 늘 틀립니다. 당신만 아는 구조 신호입니다."
    },
    "clerk": {
      "name": "서기 이든",
      "text": "잉크 묻은 손가락을 감춥니다. 명단의 숫자가 맞지 않아 퇴근하지 못했다고 말합니다."
    },
    "smuggler": {
      "name": "밀수상 루",
      "text": "비어 있는 상자 위에 앉아 있습니다. 빈 상자가 제일 비싸다고 주장합니다."
    },
    "inspector": {
      "name": "조사관 여울",
      "text": "등불을 명단 가까이 가져갑니다. 잘못을 바로잡으려면 먼저 읽을 수 있어야 한다고 말합니다."
    },
    "customs": {
      "name": "세관",
      "text": ""
    },
    "smugglers": {
      "name": "밀수조직",
      "text": ""
    },
    "guard_debt": {
      "name": "경비의 외상",
      "text": "도윤은 모라에게 찻값을 빚지고 있습니다. 돈보다 약속을 지키지 못한 일을 부끄러워합니다."
    },
    "forgery": {
      "name": "고쳐 쓴 압송 명단",
      "text": "나루의 이름은 다른 잉크로 덧써졌습니다. 조사관이 확인하면 정정 명령을 받을 수 있습니다."
    },
    "shift": {
      "name": "화물문 교대 시간",
      "text": "경비가 하품을 세 번 하면 교대가 시작됩니다. 창고의 화물문을 이용할 틈입니다."
    },
    "signal": {
      "name": "나루의 출항 신호",
      "text": "신호탑에서 등불을 두 번 가리면 작은 배가 다가옵니다."
    },
    "guard_fear": {
      "name": "경비의 두려움",
      "text": "도윤은 명령을 거스르면 자신도 수감될까 두려워합니다. 당신이 원하는 것은 복수가 아니라 구조입니다."
    },
    "ledger_truth": {
      "name": "장부의 진실",
      "text": "장부에는 세관과 밀수조직의 거래가 함께 적혀 있습니다. 주인의 약속과 조사관의 진실 중 행방을 정할 수 있습니다."
    },
    "promise": {
      "name": "채무 유예 약속",
      "text": "모라가 도윤의 외상을 미루겠다고 쓴 쪽지입니다."
    },
    "order": {
      "name": "정정 명령서",
      "text": "나루의 수감을 취소하는 조사관의 서명입니다."
    },
    "ledger": {
      "name": "밀수 장부",
      "text": "누군가에게는 증거이며 누군가에게는 생계입니다."
    },
    "lockpick": {
      "name": "작은 쇠갈고리",
      "text": "화물문의 걸쇠를 조용히 들어 올릴 수 있습니다."
    },
    "bandage": {
      "name": "마른 붕대",
      "text": "체력 3을 회복합니다. 전투 중에는 버티는 힘도 1 회복합니다."
    },
    "steady": {
      "name": "흔들리지 않는 일격",
      "text": "기술 자원 1을 사용해 공격 성공률을 높입니다."
    },
    "brace": {
      "name": "숨 고르기",
      "text": "기술 자원 1을 사용해 방어 성공률을 높입니다."
    },
    "step": {
      "name": "빠져나가는 발걸음",
      "text": "기술 자원 1을 사용해 도주 성공률을 높입니다."
    }
  },
  "roles": {
    "listener": {
      "name": "이야기 듣는 사람",
      "text": "작은 떨림을 알아봅니다. 존재감 14 · 방어 기술을 알고 시작합니다.",
      "stat": "presence",
      "skill": "brace"
    },
    "scout": {
      "name": "빈틈을 찾는 사람",
      "text": "닫힌 문 옆의 틈을 봅니다. 민첩 14 · 도주 기술과 쇠갈고리를 갖고 시작합니다.",
      "stat": "agility",
      "skill": "step",
      "item": "lockpick"
    },
    "warden": {
      "name": "앞을 막아서는 사람",
      "text": "누군가의 앞에 설 용기가 있습니다. 신체 14 · 공격 기술을 알고 시작합니다.",
      "stat": "body",
      "skill": "steady"
    }
  },
  "choices": [
    {
      "id": "notice.read",
      "target": "square",
      "label": "압송 공고를 읽습니다",
      "description": "붙인 지 얼마 되지 않은 공고입니다.",
      "show": [
        {
          "kind": "at",
          "target": "square"
        }
      ],
      "success": {
        "text": "나루의 이름만 유난히 잉크가 진합니다. 명단 원본은 화물 창고의 서기가 보관하고 있습니다. 당신은 종이의 젖지 않은 귀퉁이를 펴 줍니다.",
        "effects": []
      },
      "ticks": 0
    },
    {
      "id": "keeper.debt",
      "target": "keeper",
      "label": "경비가 어떤 사람인지 묻습니다",
      "description": "빈 찻잔에 얽힌 이야기를 듣습니다.",
      "show": [
        {
          "kind": "at",
          "target": "tavern"
        },
        {
          "kind": "knows",
          "target": "guard_debt",
          "negate": true
        }
      ],
      "success": {
        "text": "모라는 도윤의 찻잔을 가리킵니다. 외상이 늘어난 뒤로 그가 오지 않는다고 말합니다. 당신은 빚보다 부끄러움이 더 무거울 때도 있다는 것을 알게 됩니다.",
        "effects": [
          {
            "kind": "learn",
            "target": "guard_debt"
          }
        ]
      }
    },
    {
